# Set ONE of these keys (or both and choose with AI_PROVIDER).
# Anthropic (Claude): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/
OPENAI_API_KEY=

# Optional: "anthropic" or "openai". If unset, Anthropic is used when its key is set.
AI_PROVIDER=
# Optional: OpenAI model to use (default gpt-5.5).
OPENAI_MODEL=
